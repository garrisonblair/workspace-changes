          "group": "4_open@1"
        },
        {
          "command": "workspaceChanges.revealInExplorer",
          "when": "webviewId == 'workspaceChanges.view' && webviewSection == 'repo'",
          "group": "4_open@2"
        },
        {
          "command": "workspaceChanges.hideRepo",
          "when": "webviewId == 'workspaceChanges.view' && webviewSection == 'repo'",
          "group": "4_open@3"
        },
        {
          "command": "workspaceChanges.git.commit",
          "when": "webviewId == 'workspaceChanges.view' && webviewSection == 'commit'",
          "group": "1_commit@1"
        },
        {
          "command": "workspaceChanges.git.commitAmend",
          "when": "webviewId == 'workspaceChanges.view' && webviewSection == 'commit'",
          "group": "1_commit@2"
        },
        {
          "command": "workspaceChanges.commitAndPush",
          "when": "webviewId == 'workspaceChanges.view' && webviewSection == 'commit'",
          "group": "2_post@1"
        },
        {
          "command": "workspaceChanges.commitAndSync",
          "when": "webviewId == 'workspaceChanges.view' && webviewSection == 'commit'",
          "group": "2_post@2"
        },
        {
          "command": "workspaceChanges.stage",
          "when": "webviewId == 'workspaceChanges.view' && webviewSection == 'group' && group != 'index'",
          "group": "1_modify@1"
        },
        {
          "command": "workspaceChanges.unstage",
          "when": "webviewId == 'workspaceChanges.view' && webviewSection == 'group' && group == 'index'",
          "group": "1_modify@2"
        },
        {
          "command": "workspaceChanges.discard",
          "when": "webviewId == 'workspaceChanges.view' && webviewSection == 'group' && group == 'working'",
          "group": "1_modify@3"
        },
        {
          "command": "workspaceChanges.openChange",
          "when": "webviewId == 'workspaceChanges.view' && webviewSection == 'file'",
          "group": "1_open@1"
        },
        {
          "command": "workspaceChanges.openFile",
          "when": "webviewId == 'workspaceChanges.view' && webviewSection == 'file'",
          "group": "1_open@2"
        },
        {
          "command": "workspaceChanges.stage",
          "when": "webviewId == 'workspaceChanges.view' && webviewSection == 'file' && group != 'index'",
          "group": "2_modify@1"
        },
        {
          "command": "workspaceChanges.unstage",
          "when": "webviewId == 'workspaceChanges.view' && webviewSection == 'file' && group == 'index'",
          "group": "2_modify@2"
        },
        {
          "command": "workspaceChanges.discard",
          "when": "webviewId == 'workspaceChanges.view' && webviewSection == 'file' && group == 'working'",
          "group": "2_modify@3"
        }
      ],
