{
  "name": "workspace-changes",
  "displayName": "Workspace Changes",
  "description": "A Source Control panel for multi-repo workspaces: shows only the repos you care about (changes, non-default branch, ahead/behind), each with its own native-looking commit box, file icons and Git menus.",
  "version": "0.4.1",
  "publisher": "garrisonblair",
  "author": {
    "name": "Garrison Blair"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0b3d91",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/garrisonblair/workspace-changes.git"
  },
  "bugs": {
    "url": "https://github.com/garrisonblair/workspace-changes/issues"
  },
  "homepage": "https://github.com/garrisonblair/workspace-changes#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "multi-repo",
    "multi-root",
    "monorepo",
    "source control",
    "scm",
    "repositories",
    "commit",
    "filter",
    "workspace"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "test": "node test/run.js",
    "test:webview": "python3 test/webview_test.py",
    "gen:manifest": "node scripts/gen-manifest.js",
    "check:manifest": "node scripts/gen-manifest.js --check",
    "package": "npx @vscode/vsce package"
  },
  "contributes": {
    "views": {
      "scm": [
        {
          "type": "webview",
          "id": "workspaceChanges.view",
          "name": "Workspace Changes"
        }
      ]
    },
    "commands": [
