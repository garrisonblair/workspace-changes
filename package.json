      "title": "Workspace Changes",
      "properties": {
        "workspaceChanges.criteria": {
          "type": "array",
          "default": [
            "changes",
            "nonDefaultBranch"
          ],
          "items": {
            "type": "string",
            "enum": [
              "changes",
              "nonDefaultBranch",
              "unpushed",
              "behind"
            ],
            "enumDescriptions": [
              "Has staged, unstaged, untracked or conflicted files",
              "Checked-out branch is not the default branch (or HEAD is detached)",
              "Ahead of upstream, or a non-default branch that is not published",
              "Behind upstream"
            ]
          },
          "uniqueItems": true,
          "markdownDescription": "A repository is shown when it matches **any** of these rules. Empty list shows every repository. Toggle live with the filter button in the panel."
        },
        "workspaceChanges.defaultBranchNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "main",
            "master"
          ],
          "markdownDescription": "Fallback default branch names, used when a repo has no `refs/remotes/origin/HEAD` (fix that with `git remote set-head origin -a`)."
        },
        "workspaceChanges.hiddenRepositories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Repositories never shown (unless *Show All* is on). Matches the folder name or workspace-relative path; `*` and `?` wildcards allowed."
        },
