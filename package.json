          "group": "3_workspace@1"
        },
        {
          "command": "workspaceChanges.checkoutDefault",
          "when": "webviewId == 'workspaceChanges.view' && webviewSection == 'repo' && nondefault",
          "group": "3_workspace@2"
        },
        {
