    "menus": {
      "view/title": [
        {
          "command": "workspaceChanges.chooseCriteria",
          "when": "view == workspaceChanges.view",
          "group": "navigation@1"
        },
        {
          "command": "workspaceChanges.filterText",
          "when": "view == workspaceChanges.view",
          "group": "navigation@2"
        },
        {
          "command": "workspaceChanges.clearTextFilter",
          "when": "view == workspaceChanges.view && workspaceChanges.textFilterActive",
          "group": "navigation@3"
        },
        {
          "command": "workspaceChanges.showAll",
          "when": "view == workspaceChanges.view && !workspaceChanges.showAll",
          "group": "navigation@4"
        },
        {
          "command": "workspaceChanges.applyFilter",
          "when": "view == workspaceChanges.view && workspaceChanges.showAll",
          "group": "navigation@4"
        },
        {
          "command": "workspaceChanges.refresh",
          "when": "view == workspaceChanges.view",
          "group": "navigation@5"
        },
        {
          "command": "workspaceChanges.collapseAll",
          "when": "view == workspaceChanges.view && !workspaceChanges.allCollapsed",
          "group": "navigation@6"
        },
        {
          "command": "workspaceChanges.expandAll",
          "when": "view == workspaceChanges.view && workspaceChanges.allCollapsed",
          "group": "navigation@6"
        },
        {
          "command": "workspaceChanges.manageHidden",
          "when": "view == workspaceChanges.view",
          "group": "2_hidden"
        }
      ],
      "webview/context": [
        {
          "command": "workspaceChanges.git.pull",
          "when": "webviewId == 'workspaceChanges.view' && webviewSection == 'repo'",
          "group": "1_header@1"
        },
        {
          "command": "workspaceChanges.git.push",
          "when": "webviewId == 'workspaceChanges.view' && webviewSection == 'repo'",
