{
 "name": "docker",
 "contributes": {
  "languages": [
   {
    "id": "dockerfile",
    "extensions": [
     ".dockerfile",
     ".containerfile"
    ],
    "filenames": [
     "Dockerfile",
     "Containerfile"
    ],
    "filenamePatterns": [
     "Dockerfile.*",
     "Containerfile.*"
    ],
    "aliases": [
