{
 "name": "python",
 "contributes": {
  "languages": [
   {
    "id": "python",
    "extensions": [
     ".py",
     ".rpy",
     ".pyw",
     ".cpy",
     ".gyp",
     ".gypi",
     ".pyi",
     ".ipy",
     ".pyt"
    ],
    "aliases": [
     "Python",
     "py"
    ],
    "filenames": [
     "SConstruct",
     "SConscript"
    ],
    "firstLine": "^#!\\s*/?.*\\bpython[0-9.-]*\\b",
    "configuration": "./language-configuration.json"
   }
  ]
 }
}